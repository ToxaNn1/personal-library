# Postgres connection string. Required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/library

# Redis connection string. Defaults to redis://localhost:6379 when unset.
REDIS_URL=redis://localhost:6379

# Signs session cookies. Required, at least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-generated-secret

# Public URL of this API. Required.
BETTER_AUTH_URL=http://localhost:3001

# Origins allowed by CORS and trusted by better-auth. Comma-separated for more than one.
# Defaults to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000

# Port the server binds to. Defaults to 3001.
PORT=3001

# development | production | test. Defaults to development.
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=info

# Set to true only behind a reverse proxy, so the rate limiter may trust x-forwarded-for.
TRUST_PROXY=false

# Sentry DSN. Optional — when unset, error reporting is a no-op and the app runs normally.
SENTRY_DSN=
